{
  "version": 4,
  "name": "Research & Summarize",
  "description": "Research a topic with branching depth, iterative refinement, and final summary.",
  "goal": "Research the given topic thoroughly and produce a concise summary",
  "cwd": "",
  "useOrchestrator": false,
  "entryNodeId": "rs1",
  "variables": [
    {
      "name": "topic",
      "default": "AI safety"
    }
  ],
  "limits": {
    "maxTotalSteps": 50,
    "maxVisitsPerNode": 10
  },
  "nodes": [
    {
      "id": "rs1",
      "name": "Initial Research",
      "agent": "claude",
      "prompt": "Research the topic: {{var:topic}}. Provide an initial overview covering key concepts, recent developments, and open questions.",
      "kind": {
        "type": "task"
      }
    },
    {
      "id": "rs-decide",
      "name": "Decide Research Depth",
      "kind": {
        "type": "decide",
        "decideConfig": {
          "inputs": [
            {
              "name": "research",
              "source": "node:rs1.output"
            }
          ],
          "prompt": "Based on the initial research below, choose the next step. Return \"Deep dive\" if the topic warrants deeper investigation with iterative refinement, or \"Quick summary\" if the overview is sufficient and a concise final summary should be produced directly.\n\nInitial research:\n{{research}}",
          "outcomes": [
            "Deep dive",
            "Quick summary"
          ]
        }
      }
    },
    {
      "id": "rs2",
      "name": "Refine Research",
      "agent": "claude",
      "prompt": "Expand on the research so far. Add more detail, find additional perspectives, and address gaps:\n\n{{context:research}}\n\nPrior step:\n{{previous_output}}",
      "contextSources": [
        {
          "name": "research",
          "nodeId": "rs1"
        }
      ],
      "loopMaxIterations": 3,
      "kind": {
        "type": "task"
      }
    },
    {
      "id": "rs3",
      "name": "Final Summary",
      "agent": "claude",
      "prompt": "Synthesize all findings into a concise, well-structured summary report:\n\n{{context:research}}\n\nRefined research:\n{{previous_output}}",
      "contextSources": [
        {
          "name": "research",
          "nodeId": "rs1"
        }
      ],
      "kind": {
        "type": "task"
      }
    }
  ],
  "edges": [
    {
      "id": "rs1-success-decide",
      "from": "rs1",
      "to": "rs-decide",
      "outcome": "success"
    },
    {
      "id": "rs1-branch-deep",
      "from": "rs-decide",
      "to": "rs2",
      "outcome": "branch",
      "label": "Deep dive",
      "branchId": "br_deep"
    },
    {
      "id": "rs1-branch-quick",
      "from": "rs-decide",
      "to": "rs3",
      "outcome": "branch",
      "label": "Quick summary",
      "branchId": "br_quick"
    },
    {
      "id": "rs2-loop-continue",
      "from": "rs2",
      "to": "rs2",
      "outcome": "loop_continue",
      "label": "Continue research"
    },
    {
      "id": "rs2-loop-exit",
      "from": "rs2",
      "to": "rs3",
      "outcome": "loop_exit",
      "label": "Summarize"
    }
  ],
  "ui": {
    "canvas": {
      "viewport": {
        "x": 0,
        "y": 0,
        "zoom": 1
      },
      "nodes": {
        "rs1": {
          "x": 120,
          "y": 140
        },
        "rs-decide": {
          "x": 400,
          "y": 140
        },
        "rs2": {
          "x": 680,
          "y": 60
        },
        "rs3": {
          "x": 920,
          "y": 140
        }
      }
    }
  }
}
